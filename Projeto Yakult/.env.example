# =============================================================================
# Yakult Logistics Tower — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores.
#
# O projeto utiliza um banco de dados PostgreSQL na nuvem.
# Provedores compatíveis: Supabase, Neon, Railway, ElephantSQL, Render, etc.
#
# Exemplo de URL (Supabase):
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Exemplo de URL (Neon):
#   DATABASE_URL=postgresql://user:password@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# =============================================================================

DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco
